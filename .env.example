# Which data source the backend uses:
#   mock   - realistic fake data, no network (great for a demo / UI testing)
#   nse    - NSE public endpoint (free, no signup, but unofficial & may be blocked)
#   fyers  - official free feed (needs a free Fyers account; see fyers.py)
#   upstox - official free feed (needs a free Upstox account; see upstox.py)
DATA_SOURCE=mock

# How often the server refreshes data from the source, in seconds.
# NSE rate-limits, so keep this at 20s or higher.
REFRESH_SECONDS=30

# Symbols shown in the dashboard dropdown (comma separated index symbols)
# Supported: NIFTY, BANKNIFTY, FINNIFTY, MIDCPNIFTY, SENSEX, BANKEX
SYMBOLS=NIFTY,BANKNIFTY,FINNIFTY,SENSEX

# Optional password gate. Leave blank to disable (default). When set, the app
# asks for this password once and remembers it in a cookie for 30 days.
JOURNAL_PASSWORD=

# In your broker app settings, set the Redirect URL to EXACTLY this shared path
# (same port, same path) or login will fail:
#   http://127.0.0.1:8787/auth/callback

# ----- Fyers (only needed if DATA_SOURCE=fyers) -----
# Create an app at https://myapi.fyers.in/dashboard/
# App ID looks like "XXXXXX-100". Set its Redirect URL to FYERS_REDIRECT_URI below.
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=http://127.0.0.1:8787/auth/callback
# Access token is fetched daily via the Login button; normally leave this blank.
FYERS_ACCESS_TOKEN=

# ----- Upstox (only needed if DATA_SOURCE=upstox) -----
# Get these from https://account.upstox.com/developer/apps
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8787/auth/callback
UPSTOX_ACCESS_TOKEN=
